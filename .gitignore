# RU: Файл игнорирования Git для GreenCore.
# EN: Git ignore file for GreenCore.

# RU: Системные файлы / System files.
# EN: System files.
.DS_Store
Thumbs.db
desktop.ini

# RU: Папка кэша редактора VS Code.
# EN: VS Code editor cache folder.
.vscode/
.idea/
*.swp
*.swo

# RU: Временные файлы Lua.
# EN: Temporary Lua files.
*.tmp
*.log

# RU: Локальные тестовые артефакты.
# EN: Local test artifacts.
coverage/
test-results/
/build/
node_modules/
**/.env
!.env.example

# RU: Локальные настройки FiveM (не должны попадать в репозиторий).
# EN: Local FiveM settings (must not enter the repository).
/server/
/server-data/
/txData/
.codex-review-runtime/

# RU: Приватные runtime-данные identity / EN: Private identity runtime data.
/resources/\[greencore\]/gc_identity/data/identities.json
